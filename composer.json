{
    "name": "basilicom/pimcore-plugin-health-check",
    "description": "A Pimcore plugin that performs various checks regarding system health.",
    "type": "pimcore-bundle",
    "license": "MIT",
    "keywords": [
        "pimcore",
        "health check",
        "monitoring"
    ],
    "homepage": "https://basilicom.de",
    "authors": [
        {
            "name": "Christoph Luehr",
            "email": "christoph.luehr@basilicom.de",
            "homepage": "https://www.basilicom.de",
            "role": "Developer"
        },
        {
            "name": "Kerstin Gerull",
            "email": "kerstin.gerull@basilicom.de",
            "homepage": "https://www.basilicom.de",
            "role": "Developer"
        },
        {
            "name": "Alexander Heidrich",
            "email": "alexander.heidrich@basilicom.de",
            "homepage": "https://www.basilicom.de",
            "role": "Developer"
        },
        {
            "name": "Basilicom GmbH",
            "homepage": "https://basilicom.de"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require": {
        "php": "^8.3",
        "pimcore/pimcore": "^11.0 || ^12.0 || ^2026.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Basilicom\\PimcorePluginHealthCheck\\": "src/"
        },
        "exclude-from-classmap": [
            "tests"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Basilicom\\PimcorePluginHealthCheck\\Tests\\": "tests/"
        }
    },
    "extra": {
        "pimcore": {
            "bundles": [
                "Basilicom\\PimcorePluginHealthCheck\\PimcorePluginHealthCheckBundle"
            ]
        }
    }
}
